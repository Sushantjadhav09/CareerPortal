package com.example.CareerPT.utility;

public class Data {
	
	public static String buildOtpEmailTemplate(String otp) {

	    String html = """
	        <!DOCTYPE html>
	        <html>
	        <body style="margin:0; padding:0; background-color:#f4f6f8; font-family:Arial;">

	        <table width="100%" cellpadding="0" cellspacing="0">
	            <tr>
	                <td align="center">

	                    <table width="600" style="background:#ffffff; margin:40px 0; border-radius:8px;">
	                        <tr>
	                            <td style="background:#0d6efd; padding:20px; text-align:center;">
	                                <h1 style="color:#ffffff;">ABC Security</h1>
	                            </td>
	                        </tr>

	                        <tr>
	                            <td style="padding:30px;">
	                                <p>Hello,</p>

	                                <p>Your One-Time Password (OTP):</p>

	                                <div style="text-align:center; margin:30px 0;">
	                                    <span style="font-size:26px; letter-spacing:6px; font-weight:bold;">
	                                        {{OTP}}
	                                    </span>
	                                </div>

	                                <p>This OTP is valid for 5 minutes.</p>
	                                <p>Do not share it with anyone.</p>

	                                <p>Regards,<br><b>ABC Security Team</b></p>
	                            </td>
	                        </tr>

	                        <tr>
	                            <td style="background:#f4f6f8; padding:15px; text-align:center;">
	                                <small>This is an automated message. Please do not reply.</small>
	                            </td>
	                        </tr>
	                    </table>

	                </td>
	            </tr>
	        </table>

	        </body>
	        </html>
	        """;

	    return html.replace("{{OTP}}", otp);
	}


}
